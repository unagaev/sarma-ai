from pathlib import Path
import sys
project_root = Path.cwd().parent
sys.path.append(str(project_root))
from src.sarma.ingestion.loader import load_pdf
from src.sarma.ingestion.splitter import split_documents
from sarma.vectorstore.vectorstore import create_vector_store
from sarma.retriever import create_retriever


documents = load_pdf((Path("../data/RB209 Arable crops.pdf")))

print("Pages:", len(documents))


chunks = split_documents(documents)
db = create_vector_store(chunks)
print("SARMA knowledge base created ")


retriever = create_retriever(db)
results = retriever.invoke("What is the spatial resolution of Sentinel-2?")


for r in results:
    print("--------------------")
    print(r.page_content[:500])



